// Generated by BiocJobs 0.99.0 from the 'variantannotation-extract-numeric-genotypes' job declared in
// Bioconductor package VariantAnnotation (inst/biocjobs/). Do not edit;
// regenerate with: Rscript -e 'BiocJobs::biocjobsCLI()' nextflow <pkg> variantannotation-extract-numeric-genotypes

process VARIANTANNOTATION_EXTRACT_NUMERIC_GENOTYPES {
    tag "variantannotation-extract-numeric-genotypes"
    container 'bioconductor/bioconductor_docker:RELEASE_3_23'
    cpus 1
    memory '16 GB'
    disk '10 GB'

    input:
    // VCF (variant call format) file (vcf)
    path vcf
    // TBI tabix index for VCF (tbi)
    path index
    // BED file of regions to include (bed)
    path bed
    // File listing samples to include (txt)
    path samples

    output:
    path 'genotypes.tsv', emit: genotypes

    script:
    """
    Rscript -e 'BiocJobs::execJob("VariantAnnotation", "variantannotation-extract-numeric-genotypes")' \\
        --vcf '${(vcf as String).replace("'", "'\\''")}' \\
        --index '${(index as String).replace("'", "'\\''")}' \\
        --bed '${(bed as String).replace("'", "'\\''")}' \\
        --samples '${(samples as String).replace("'", "'\\''")}' \\
        --genotypes 'genotypes.tsv'
    """

    stub:
    """
    touch 'genotypes.tsv'
    """
}
